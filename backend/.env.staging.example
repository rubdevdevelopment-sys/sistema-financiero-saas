NODE_ENV=development
PORT=4000

# Staging only. Never copy production values here.
SUPABASE_URL=https://[YOUR-STAGING-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-STAGING-ANON-KEY]
DATABASE_URL=postgresql://postgres.[YOUR-STAGING-PROJECT-REF]:[YOUR-STAGING-PASSWORD]@[YOUR-STAGING-HOST]:5432/postgres

JWT_SECRET=[YOUR-STAGING-JWT-SECRET]
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

APP_NAME=Sistema Financiero SaaS
